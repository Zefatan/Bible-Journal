# Get a free API key at https://scripture.api.bible
VITE_BIBLE_API_KEY=your_api_key_here

# Firebase (free) — for multi-device sync and account login
# See FIREBASE_SETUP.md for step-by-step setup instructions
VITE_FIREBASE_API_KEY=your_value_here
VITE_FIREBASE_AUTH_DOMAIN=your_value_here
VITE_FIREBASE_PROJECT_ID=your_value_here
VITE_FIREBASE_STORAGE_BUCKET=your_value_here
VITE_FIREBASE_MESSAGING_SENDER_ID=your_value_here
VITE_FIREBASE_APP_ID=your_value_here

# Closed-app reminders: Firebase Console → Project settings → Cloud Messaging
# → Web Push certificates → "Key pair". Leave blank to use in-app reminders only.
VITE_FIREBASE_VAPID_KEY=
